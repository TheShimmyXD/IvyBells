# Entorno y cachés
# Lo que deja pip al instalar la copia de jacck_common
vendor/jacck_common/build/
vendor/jacck_common/*.egg-info/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Datos sensibles o propios de esta máquina
local_settings.json
# Preferencias de la ventana en esta máquina (tema)
resources/json/app_settings.json
secure_credentials.json
# Perfil del agente con los datos de la empresa
resources/agent/perfil_local.md
resources/agent/perfiles/*
!resources/agent/perfiles/ejemplo.md
resources/agent/contexto/
resources/agent/contextos/
logs/

# Audio y transcripciones reales (no se versionan)
grabaciones/
transcripciones/

# Logs de corridas largas del banco (los .json y .md sí se versionan)
bench/resultados/*.log

# -- Ventana de Tauri ------------------------------------------
# Sin .cargo/ la compilacion queda aqui (otra maquina). En la del autor, install.sh escribe
# .cargo/config.toml hacia la compartida de ../jacck_common: es local, no va a Git.
desktop/src-tauri/target/
# Copia del binario que deja install.sh en otra maquina antes de borrar target/
desktop/bin/
desktop/src-tauri/.cargo/
desktop/src-tauri/gen/
resources/json/api_session.json
